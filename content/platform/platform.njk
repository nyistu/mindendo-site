---
pagination:
  data: platforms
  size: 1
  alias: platform
permalink: "/platform/{{ platform.slug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ platform.label }} tesztek"
---
<h1>{{ platform.label }} tesztek</h1>

<div class="filter-bar">
  <a href="/tesztek/">Mind</a>
  {% for p in platforms %}
  <a href="/platform/{{ p.slug }}/" class="{% if p.slug == platform.slug %}active{% endif %}">{{ p.label }}</a>
  {% endfor %}
</div>

{% set matches = collections.teszt | byPlatform(platform.slug) | reverse %}
{% if matches.length %}
<div class="card-grid">
  {% for post in matches %}
  <a href="{{ post.url }}" class="post-card">
    <img src="{{ post.data.cover | coverOrDefault }}" alt="{{ post.data.title }}">
    <div class="card-body">
      <span class="platform-badge">{{ post.data.platform }}</span>
      <h3>{{ post.data.title }}</h3>
      <div class="meta">{{ post.data.date.toDateString() }} · {{ post.data.rating }}/5 ★</div>
    </div>
  </a>
  {% endfor %}
</div>
{% else %}
<p style="color: var(--muted);">Erre a platformra még nincs teszt — hamarosan pótoljuk.</p>
{% endif %}
